{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["source_name", "verification"],
  "properties": {
    "source_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.py$"},
    "verification": {"const": "binary_tree_diameter"},
    "expected_diameter": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
